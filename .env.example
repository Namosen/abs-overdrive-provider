# Bearer token ABS sends with every metadata request.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=your_secret_token_here

# Comma-separated OverDrive library slugs to search in parallel.
# The slug is found in your Libby URL: libbyapp.com/library/<SLUG>
# Default covers US and UK broadly. Add your local library for best results.
LIBRARY_KEYS=nypl,londonlibraries,tlc

# Port the provider listens on
PORT=3847
